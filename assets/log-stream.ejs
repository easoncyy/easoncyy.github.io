```{=html}
<div class="log-stream">
<% for (const item of items) { %>
  <article class="log-entry" data-log-kind="<%- item.kind || 'note' %>">
    <div class="log-stamp"><time datetime="<%- item.timestamp %>"><%- item.timestamp %></time><span class="log-kind"><%- (item.kind || 'note').toUpperCase() %></span></div>
    <div class="log-payload">
      <div class="log-request">host=<%- item.host || 'easoncyy.github.io' %> &nbsp; GET <%- item.path.replace(/\\/g, '/').replace(/index\.qmd$/, '') %></div>
      <h2><a href="<%- item.path %>"><%- item.title %></a></h2>
      <p><%- item.description || '' %></p>
      <% if (item['log-image']) { %>
      <a href="<%- item.path %>" class="log-image-link"><img src="<%- item['log-image'] %>" alt="<%- item['image-alt'] || item.title %>" loading="lazy"></a>
      <% } %>
      <% if (item['shared-url']) { %>
      <a class="log-shared-link" href="<%- item['shared-url'] %>" target="_blank" rel="noopener noreferrer"><%- item['shared-url'] %> ↗</a>
      <% } %>
      <a class="log-detail" href="<%- item.path %>">open / 阅读与评论 →</a>
    </div>
  </article>
<% } %>
</div>
```
